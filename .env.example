# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key-at-least-50-chars-long-xxx
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 17
DATABASE_URL=postgresql://ilims_user:ilims_password@localhost:5432/ilims_db
DB_NAME=ilims_db
DB_USER=ilims_user
DB_PASSWORD=ilims_password
DB_HOST=localhost
DB_PORT=5432

# Redis (optional, for Celery)
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ilims@example.com

# Security
CSRF_TRUSTED_ORIGINS=http
://localhost:8000
SESSION_IDLE_TIMEOUT=1800