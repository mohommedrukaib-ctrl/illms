{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15
      }
    },
    {
      "src": "build.sh",
      "use": "@vercel/bash"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}